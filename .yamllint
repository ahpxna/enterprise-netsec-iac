---
extends: default
ignore: |
  .github/
  clab-*/
  .venv/
rules:
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
    # Cloud-init requires the exact first-line marker `#cloud-config`.
    ignore: |
      terraform/libvirt/cloud-init/user-data.yml
  braces:
    max-spaces-inside: 1
