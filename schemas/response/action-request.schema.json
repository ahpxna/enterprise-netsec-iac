{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyxyz.test/schemas/response/action-request-v1.json",
  "title": "CompanyXYZ correlation-gated response request",
  "type": "object",
  "required": [
    "schema_version", "correlation_id", "entity", "action", "reason", "ai_score",
    "model_id", "signals", "ttl_seconds", "allowlist_checked", "rollback_required",
    "requested_at", "decision_event_id", "policy_id", "policy_sha256",
    "idempotency_key", "issued_by"
  ],
  "properties": {
    "schema_version": {"const": "response-request-v1"},
    "correlation_id": {"type": "string", "minLength": 1},
    "decision_event_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 512},
    "issued_by": {"const": "decision_engine"},
    "entity": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["ip", "host"]},
        "id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "ip"}}, "required": ["type"]},
          "then": {"properties": {"id": {"$ref": "#/$defs/ipAddress"}}}
        }
      ],
      "additionalProperties": false
    },
    "action": {"enum": ["block_ip", "isolate_host"]},
    "reason": {"type": "string", "minLength": 1},
    "ai_score": {"type": "number", "minimum": 0.9, "maximum": 1},
    "model_id": {"type": "string", "minLength": 1},
    "signals": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": {"enum": ["ai", "suricata", "wazuh", "authentication", "threat_intel", "protected_asset"]},
          "reference": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {"type": {"const": "ai"}},
            "required": ["type"]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "enum": ["suricata", "wazuh", "authentication", "threat_intel", "protected_asset"]
              }
            },
            "required": ["type"]
          },
          "minContains": 1
        }
      ]
    },
    "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "allowlist_checked": {"const": true},
    "rollback_required": {"const": true},
    "requested_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "block_ip"}}, "required": ["action"]},
      "then": {
        "properties": {
          "entity": {
            "properties": {"type": {"const": "ip"}},
            "required": ["type"]
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "isolate_host"}}, "required": ["action"]},
      "then": {
        "properties": {
          "entity": {
            "properties": {"type": {"const": "host"}},
            "required": ["type"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "ipAddress": {
      "type": "string",
      "oneOf": [
        {"format": "ipv4"},
        {"format": "ipv6"}
      ]
    }
  },
  "additionalProperties": false
}
