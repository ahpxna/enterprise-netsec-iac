# Keep secrets, runtime state and bulky evidence out of every build context.
.git
.env
.env.*
!.env.example
**/*.key
**/*.pem
**/*.p12
**/*.joblib
**/*.safetensors
soc/certs
soc/runtime
docker/syslog-relay/certs
docker/zero-trust-gateway/certs
docker/wazuh/certs
docker/wazuh/generated
wireguard
evidence
datasets/raw
datasets/processed
datasets/replays
ai/registry/artifacts
ai/registry/active
**/__pycache__
**/.DS_Store
terraform/**/.terraform
*.tfstate*
clab-*
