{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyxyz.test/response/schemas/response-audit-event-v1.schema.json",
  "title": "CompanyXYZ append-only response audit and state event v1",
  "description": "One immutable audit document per response state transition. APPLIED is not a successful outcome; only VERIFIED records proven enforcement.",
  "type": "object",
  "required": [
    "@timestamp",
    "schema_version",
    "event",
    "audit_event_id",
    "response_id",
    "transition_number",
    "decision_event_id",
    "correlation_id",
    "policy_id",
    "idempotency_key",
    "target",
    "action",
    "adapter",
    "state",
    "previous_state",
    "ttl_seconds",
    "expires_at",
    "allowlist_checked",
    "rollback_required"
  ],
  "properties": {
    "@timestamp": {"type": "string", "format": "date-time"},
    "schema_version": {"const": "response-audit-event-v1"},
    "event": {
      "type": "object",
      "required": ["id", "kind", "category", "dataset"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "event"},
        "category": {
          "type": "array",
          "minItems": 1,
          "contains": {"const": "response"}
        },
        "dataset": {"const": "soc.response.audit"}
      },
      "additionalProperties": false
    },
    "audit_event_id": {"type": "string", "minLength": 1},
    "response_id": {"type": "string", "minLength": 1},
    "transition_number": {"type": "integer", "minimum": 1},
    "decision_event_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 512},
    "target": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {"enum": ["ip", "host"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 255}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "ip"}}, "required": ["type"]},
          "then": {"properties": {"value": {"$ref": "#/$defs/ipAddress"}}}
        }
      ],
      "additionalProperties": false
    },
    "action": {"enum": ["block_ip", "isolate_host"]},
    "adapter": {"enum": ["opnsense", "nftables", "vyos", "wazuh"]},
    "state": {"enum": ["REQUESTED", "APPLIED", "VERIFIED", "EXPIRED", "ROLLED_BACK", "FAILED"]},
    "previous_state": {"type": ["string", "null"], "enum": [null, "REQUESTED", "APPLIED", "VERIFIED", "EXPIRED", "ROLLED_BACK", "FAILED"]},
    "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "expires_at": {"type": "string", "format": "date-time"},
    "allowlist_checked": {"const": true},
    "rollback_required": {"const": true},
    "action_intent": {
      "type": "object",
      "required": ["operation", "started_at", "adapter_reference"],
      "properties": {
        "operation": {"enum": ["apply", "revert"]},
        "started_at": {"type": "string", "format": "date-time"},
        "adapter_reference": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "application": {
      "type": "object",
      "required": ["applied_at", "adapter_reference"],
      "properties": {
        "applied_at": {"type": "string", "format": "date-time"},
        "adapter_reference": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["verified", "verified_at", "evidence_refs"],
      "properties": {
        "verified": {"type": "boolean"},
        "verified_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "verification_latency_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "rollback": {
      "type": "object",
      "required": ["completed_at", "cause", "evidence_refs"],
      "properties": {
        "completed_at": {"type": "string", "format": "date-time"},
        "cause": {"enum": ["ttl_expired", "manual", "failed_verification", "recovery"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["code", "message", "failed_at"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 2048},
        "failed_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "block_ip"}}, "required": ["action"]},
      "then": {
        "properties": {
          "adapter": {"enum": ["opnsense", "nftables", "vyos"]},
          "target": {"properties": {"type": {"const": "ip"}}, "required": ["type"]}
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "isolate_host"}}, "required": ["action"]},
      "then": {
        "properties": {
          "adapter": {"const": "wazuh"},
          "target": {"properties": {"type": {"const": "host"}}, "required": ["type"]}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "REQUESTED"}}, "required": ["state"]},
      "then": {"properties": {"previous_state": {"const": null}}}
    },
    {
      "if": {"properties": {"state": {"const": "APPLIED"}}, "required": ["state"]},
      "then": {
        "required": ["application"],
        "properties": {"previous_state": {"const": "REQUESTED"}}
      }
    },
    {
      "if": {"properties": {"state": {"const": "VERIFIED"}}, "required": ["state"]},
      "then": {
        "required": ["application", "verification"],
        "properties": {
          "previous_state": {"const": "APPLIED"},
          "verification": {"properties": {"verified": {"const": true}}, "required": ["verified"]}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "EXPIRED"}}, "required": ["state"]},
      "then": {
        "required": ["rollback"],
        "properties": {"previous_state": {"const": "VERIFIED"}}
      }
    },
    {
      "if": {"properties": {"state": {"const": "ROLLED_BACK"}}, "required": ["state"]},
      "then": {
        "required": ["rollback"],
        "properties": {"previous_state": {"enum": ["REQUESTED", "APPLIED", "VERIFIED", "FAILED"]}},
        "allOf": [{
          "if": {"properties": {"previous_state": {"const": "REQUESTED"}}, "required": ["previous_state"]},
          "then": {"required": ["action_intent"]}
        }]
      }
    },
    {
      "if": {"properties": {"state": {"const": "FAILED"}}, "required": ["state"]},
      "then": {"required": ["failure"]}
    }
  ],
  "$defs": {
    "ipAddress": {
      "type": "string",
      "oneOf": [
        {"format": "ipv4"},
        {"format": "ipv6"}
      ]
    }
  },
  "additionalProperties": false
}
