#!/usr/sbin/nft -f
# =====================================================================
# fw-dmz  —  DMZ firewall (was ASAv-DMZ-I)
# OUTSIDE(edge/internet) sec-level 0  |  INSIDE(dmz-web) sec-level 100
# Only publish 80/443 to the web host; DNS/53 from edge; nothing else in.
# DMZ can reach out (established), Internet cannot initiate inbound.
# =====================================================================
flush ruleset

table inet dmz {
    set web { type ipv4_addr; elements = { 195.1.1.161 } }

    chain inbound {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        iif "lo" accept
        log prefix "CXYZ-FWDMZ-IN-DROP " flags all counter drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related accept
        # Internet -> web host: HTTP/HTTPS only
        ip daddr @web tcp dport { 80, 443 } accept
        # edge -> web host: DNS
        ip daddr @web udp dport 53 accept
        # DMZ egress to Internet allowed (established handles the return)
        ip saddr @web accept
        # Explicitly deny + log DMZ -> internal (no pivot to campus/DC)
        ip saddr @web ip daddr { 172.16.0.0/16, 192.168.0.0/16 } \
            log prefix "CXYZ-FWDMZ-PIVOT-DROP " flags all counter drop
        log prefix "CXYZ-FWDMZ-FWD-DROP " flags all counter drop
    }
}
