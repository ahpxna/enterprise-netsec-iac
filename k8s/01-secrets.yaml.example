# TEMPLATE — do NOT apply as-is. Copy to 01-secrets.yaml (gitignored),
# fill real values, or better: generate with `kubectl create secret
# generic ... --from-literal=` so nothing plaintext ever touches disk.
# Mirrors the same secrets docker-compose reads from .env.
apiVersion: v1
kind: Secret
metadata:
  name: cxyz-security-secrets
  namespace: cxyz-security
type: Opaque
stringData:
  WAZUH_INDEXER_PASSWORD: "CHANGE_ME"
  WAZUH_DASHBOARD_PASSWORD: "CHANGE_ME"
  AUTHENTIK_SECRET_KEY: "CHANGE_ME"
  AUTHENTIK_POSTGRES_PASSWORD: "CHANGE_ME"
