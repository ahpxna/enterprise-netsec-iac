<!-- =====================================================================
     CompanyXYZ detection rules. This is where DET-01 becomes real:
     a firewall DROP on the prohibited user->DC path raises a level-10
     alert that shows up in the Wazuh dashboard.
     ===================================================================== -->
<group name="cxyz,firewall,">

  <rule id="100200" level="5">
    <decoded_as>cxyz-nft</decoded_as>
    <description>CompanyXYZ firewall drop event</description>
  </rule>

  <rule id="100201" level="10" frequency="2" timeframe="30">
    <if_matched_sid>100200</if_matched_sid>
    <match>CXYZ-FWCORE-FWD-DROP</match>
    <description>Prohibited internal scan: repeated user->DC drops (DET-01)</description>
    <mitre><id>T1046</id></mitre>
    <group>attack,recon,</group>
  </rule>

  <rule id="100202" level="12">
    <if_matched_sid>100200</if_matched_sid>
    <match>CXYZ-FWDMZ-PIVOT-DROP</match>
    <description>DMZ attempting to pivot inward (SEG-02 violation attempt)</description>
    <mitre><id>T1210</id></mitre>
    <group>attack,lateral_movement,</group>
  </rule>

  <rule id="100203" level="3">
    <match>CXYZ-DET02-TLS-MARKER</match>
    <description>Authenticated TLS syslog transport marker received (DET-02)</description>
    <group>syslog,</group>
  </rule>
  <!-- Path B VyOS uses the native nftables firewall logger rather than the
       custom Path A nft prefix. Correlate the denied validation scan by its
       real data-plane source/destination pair. -->
  <rule id="100204" level="10" frequency="2" timeframe="30">
    <regex>SRC=192\.168\.10\.1 DST=172\.16\.50\.1</regex>
    <description>Path B prohibited user-to-DC scan denied by VyOS fw-core (DET-01)</description>
    <mitre><id>T1046</id></mitre>
    <group>attack,recon,path_b,</group>
  </rule>

</group>
