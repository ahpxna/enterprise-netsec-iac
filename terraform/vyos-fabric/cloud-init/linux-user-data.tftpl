#cloud-config
hostname: ${hostname}
manage_etc_hosts: true

users:
  - default
  - name: ansible
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_key}

ssh_pwauth: false

# Do not run apt during first boot. Path B deliberately keeps BGP/OSPF
# authentication fail-closed until Ansible reconciles the real routing
# secrets, so Internet package repositories are not a valid bootstrap
# dependency. The pinned Ubuntu cloud image already contains Python/SSH;
# Day-2 installs the remaining packages after routing is established.
runcmd:
  - [systemctl, enable, --now, ssh]
