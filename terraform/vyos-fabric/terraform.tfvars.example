# Copy to terraform.tfvars and fill in reviewed local image paths/digests.
# Only ssh_public_key is generated into ignored bootstrap.auto.tfvars.json by
# `make path-b-vars`. BGP/OSPF credentials never enter Terraform state.
libvirt_uri = "qemu:///system"

# Select one exact cloud-init-enabled VyOS 1.4.x image after validating every
# config.boot file against it. Never use a rolling/current filename here.
vyos_image_path   = "/var/lib/libvirt/images/base/vyos-1.4.2-cloud-init.qcow2"
vyos_image_sha256 = "REPLACE_WITH_THE_REVIEWED_64_HEX_SHA256_OF_THE_QCOW2"

linux_image_path   = "/var/lib/libvirt/images/base/ubuntu-24.04-server-cloudimg-amd64.img"
linux_image_sha256 = "REPLACE_WITH_THE_REVIEWED_64_HEX_SHA256_OF_THE_QCOW2"

# Optional overrides remain part of the 12-node topology and must be pinned.
# node_image_overrides = {
#   edge = {
#     path   = "/var/lib/libvirt/images/base/custom-edge.qcow2"
#     sha256 = "REPLACE_WITH_64_HEX_SHA256"
#   }
# }
