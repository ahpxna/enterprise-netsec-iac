# =====================================================================
# CompanyXYZ-NG : environment template
# cp .env.example .env  &&  edit  &&  NEVER commit .env
# Generate strong values:  openssl rand -base64 36
# =====================================================================

# --- Deployment identity ---
ORG_NAME="CompanyXYZ"
ORG_DOMAIN="companyxyz.lab"
DEPLOY_ENV="lab"                 # lab | staging | prod

# --- SIEM (Wazuh) ---
WAZUH_INDEXER_PASSWORD=CHANGE_ME_indexer
WAZUH_API_PASSWORD=CHANGE_ME_api
WAZUH_DASHBOARD_PASSWORD=CHANGE_ME_dashboard
WAZUH_REGISTRATION_PASSWORD=CHANGE_ME_agent_enrollment_min_32_chars
WAZUH_MANAGER_IP=172.16.50.10

# --- SOC analytics plane (Elastic Stack) ---
ELASTIC_PASSWORD=CHANGE_ME_elastic_admin_min_32_chars
KIBANA_SYSTEM_PASSWORD=CHANGE_ME_kibana_system_min_32_chars
KIBANA_BOOTSTRAP_PASSWORD=CHANGE_ME_kibana_bootstrap_min_32_chars
LOGSTASH_PASSWORD=CHANGE_ME_logstash_writer_min_32_chars
KIBANA_SECURITY_ENCRYPTION_KEY=CHANGE_ME_exactly_or_more_than_32_chars
KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=CHANGE_ME_exactly_or_more_than_32_chars
KIBANA_REPORTING_ENCRYPTION_KEY=CHANGE_ME_exactly_or_more_than_32_chars

# --- RADIUS / AAA (one-way SHA-512 crypt + unique client secrets) ---
RADIUS_SECRET_FW_CORE=CHANGE_ME_unique_fw_core_min_32_chars
RADIUS_SECRET_CORE=CHANGE_ME_unique_core_min_32_chars
RADIUS_SECRET_EDGE=CHANGE_ME_unique_edge_min_32_chars
RADIUS_SECRET_PC4=CHANGE_ME_unique_pc4_min_32_chars
RADIUS_SECRET_PC1_PROBE=CHANGE_ME_unique_pc1_probe_min_32_chars
RADIUS_ADMIN_CRYPT=CHANGE_ME_see_scripts_mkhash
RADIUS_TEST_PASSWORD=CHANGE_ME_ephemeral_integration_password
RADIUS_TEST_CRYPT=CHANGE_ME_see_scripts_mkhash
BGP_ISP1_SECRET=CHANGE_ME_unique_bgp_isp1_min_24_chars
BGP_ISP2_SECRET=CHANGE_ME_unique_bgp_isp2_min_24_chars
OSPF_MD5_SECRET=CHANGE_ME_unique_ospf_md5_min_24_chars

# --- Path B bootstrap (public material; used by Terraform + Ansible) ---
PATH_B_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# --- Zero-Trust gateway ---
AUTHENTIK_SECRET_KEY=CHANGE_ME_50_chars
AUTHENTIK_POSTGRES_PASSWORD=CHANGE_ME_pg
TRAEFIK_ACME_EMAIL=you@example.com
PUBLIC_HOSTNAME=gw.example.com

# --- WireGuard ---
WG_SERVER_PORT=51820
WG_ENDPOINT=vpn.example.com
WG_PEER_COUNT=4

# --- NTP (NTS-capable upstreams) ---
NTP_UPSTREAM_1=time.cloudflare.com
NTP_UPSTREAM_2=nts.netnod.se

# --- SOC service identities for Kubernetes Path C (Compose uses per-service API keys) ---
SOC_FEATURE_PASSWORD=CHANGE_ME_soc_feature_min_32_chars
SOC_AI_WRITER_PASSWORD=CHANGE_ME_soc_ai_writer_min_32_chars
SOC_DECISION_PASSWORD=CHANGE_ME_soc_decision_min_32_chars
SOC_RESPONSE_PASSWORD=CHANGE_ME_soc_response_min_32_chars

# --- SOC AI / response (profile soc-ai) ---
# Digest of the APPROVED model metadata, supplied independently of the registry
# (printed by `make soc-ai-promote`). Without it the AI services refuse to start.
SOC_AI_METADATA_SHA256=
SOC_GIT_SHA=0000000
SOC_PATH=path-a                 # path-a | path-b  (selects response/deployments/<path>/)
SOC_POLICY=default              # default | lab-path-b | lab-validation | lab-validation-path-b
SOC_MODE=                       # empty = reviewed deployment mode (observe). `enforce` ONLY for `make soc-ai-validate`
# Optional orchestrator secrets (written to its private volume; never logged)
VYOS_API_KEY=CHANGE_ME_vyos_api_key_min_32_chars
WAZUH_RESPONSE_CREDENTIALS=CHANGE_ME_wazuh_response_credentials   # becomes cxyz-response:<password>
OPNSENSE_CREDENTIALS=           # <api_key>:<api_secret> (production OPNsense backend)
